# Staff/demo bypass code — lets ARPS showcase the game at the stand without
# spending a real player's attempt and without the run ever reaching the
# leaderboard. See src/demo.ts for exactly what this does and doesn't protect.
#
# Set this in Cloudflare Pages' environment variables for the production
# build. Do not commit the real value — copy this file to .env.local instead,
# which is gitignored. Rotate the code after the event.
#
# To unlock on a staff device, visit once:  <site>/?staff=<this value>
# To hand a device back to normal:          <site>/?staff=off
VITE_STAFF_CODE=
