# Secrets for the register / submit-run functions, beyond the SUPABASE_URL and
# SUPABASE_SERVICE_ROLE_KEY the Edge Runtime injects automatically.
#
# Local dev: copy to supabase/functions/.env (gitignored) and fill with random
# base64 values, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Production: set with `supabase secrets set` using DIFFERENT values. Never commit real values.

# HMAC key for the email/phone dedupe hash.
EMAIL_HASH_SECRET=

# AES-256-GCM key encrypting the stored email/phone columns.
EMAIL_ENC_KEY=

# HMAC key signing play-token capability strings.
TOKEN_SECRET=
